    {
      "term": "RRM",
      "group": "Bayesian & statistics",
      "expansion": "Reliability-Refinement Metric",
      "note": "1 − ‖v‖ over a penalty vector v = [1−A, s, U] (accuracy shortfall, fold-instability, epistemic spread); lower ‖v‖ = more reliable. RRM_w is the simplex-weighted generalization."
    },
    {
      "term": "GGN",
      "group": "Bayesian & statistics",
      "expansion": "Generalized Gauss-Newton",
      "note": "Positive-semidefinite curvature/precision matrix of the last layer; its eigenbasis (U, λ) is what LLLA uses to form the posterior and the eigenspectrum."
    },
    {
      "term": "γ (data-information fraction)",
      "group": "Bayesian & statistics",
      "expansion": "γ = λ / (λ + τ) ∈ [0,1]",
      "note": "Per eigen-direction, the continuous fraction of the way from prior (0) to data-determined (1). Σγ = effective dimension; the graded replacement for the binary λ>τ cut."
    },
    {
      "term": "PICP",
      "group": "Bayesian & statistics",
      "expansion": "Prediction Interval Coverage Probability",
      "note": "Fraction of held-out truths that fall inside the predicted 95% credible band; ≈0.95 = calibrated."
    },
    {
      "term": "CRPS",
      "group": "Bayesian & statistics",
      "expansion": "Continuous Ranked Probability Score",
      "note": "Proper scoring rule for a probabilistic prediction — rewards sharpness subject to calibration."
    },
    {
      "term": "Pareto front",
      "group": "Bayesian & statistics",
      "expansion": "Non-dominated set in a multi-objective tradeoff",
      "note": "In FORGE's Optimization Frontier: backbones plotted in accuracy-gap vs uncertainty; dominated models are arrowed toward the front (their optimization room)."
    },
    {
      "term": "EMD",
      "group": "Data & benchmarks",
      "expansion": "Earth Mover's Distance (Wasserstein-1)",
      "note": "The phonon mk2 loss — compares two DOS spectra by mass transport rather than bin-wise error; the headline backbone for the phonon reproduction."
    },
    {
      "term": "DOS",
      "group": "Physics & ATLAS",
      "expansion": "(Phonon) Density of States",
      "note": "The 51-bin phonon spectrum FORGE's phonon model regresses (Chen et al. 2021, E(3)-equivariant reproduction)."
    }
  ]
